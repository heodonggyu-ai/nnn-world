{
 "rules": {
  "pins": {
   "$k": {
    ".read": false,
    ".write": "auth != null && !data.exists() && newData.isString() && newData.val().matches(/^[0-9]{4}$/) && $k.length >= 2 && $k.length <= 8"
   }
  },
  "devices": {
   "$k": {
    "$uid": {
     ".read": false,
     ".write": "auth != null && auth.uid === $uid && newData.child('pin').val() === root.child('pins').child($k).val()"
    }
   }
  },
  "profiles": {
   ".read": "auth != null",
   "$k": {
    ".write": "auth != null && root.child('devices').child($k).child(auth.uid).exists()",
    ".validate": "newData.hasChildren(['nick'])",
    "nick": {
     ".validate": "newData.isString() && newData.val().length <= 8"
    },
    "credits": {
     ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
    },
    "av": {
     "base": {
      ".validate": "newData.isString() && (newData.val() !== 'mingnyu' || $k === '밍뉴')"
     }
    }
   }
  },
  "saves": {
   "$k": {
    ".read": "auth != null && root.child('devices').child($k).child(auth.uid).exists()",
    "$game": {
     ".write": "auth != null && root.child('devices').child($k).child(auth.uid).exists()",
     "data": {
      ".validate": "newData.isString() && newData.val().length < 200000"
     }
    }
   }
  },
  "meta": {
   ".read": "auth != null",
   ".write": "auth != null && root.child('devices').child('밍뉴').child(auth.uid).exists()"
  },
  "requests": {
   ".read": "auth != null && root.child('devices').child('밍뉴').child(auth.uid).exists()",
   "$k": {
    ".read": "auth != null && root.child('devices').child($k).child(auth.uid).exists()",
    ".write": "auth != null && (root.child('devices').child($k).child(auth.uid).exists() || root.child('devices').child('밍뉴').child(auth.uid).exists())"
   }
  },
  "rooms": {
   "$code": {
    ".read": "auth != null",
    "host": {
     ".write": "auth != null && !data.exists() && root.child('devices').child('밍뉴').child(auth.uid).exists()"
    },
    "game": {
     ".write": "auth != null && !data.exists() && newData.isString()"
    },
    "created": {
     ".write": "auth != null && !data.exists()"
    },
    "allowed": {
     "$k": {
      ".write": "auth != null && root.child('devices').child('밍뉴').child(auth.uid).exists()"
     }
    },
    "players": {
     "$k": {
      ".write": "auth != null && (root.child('devices').child('밍뉴').child(auth.uid).exists() || (root.child('devices').child($k).child(auth.uid).exists() && (!newData.exists() || root.child('rooms').child($code).child('allowed').child($k).exists() || root.child('rooms').child($code).child('host').val() === $k)))",
      "n": {
       ".validate": "newData.isString() && newData.val().length <= 8"
      }
     }
    }
   }
  },
  "gym": {
   "adminPin": {
    ".read": false,
    ".write": "auth != null && (!data.exists() || root.child('gym/admins').child(auth.uid).exists()) && newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
   },
   "admins": {
    "$uid": {
     ".read": "auth != null && auth.uid === $uid",
     ".write": "auth != null && auth.uid === $uid && newData.child('pin').val() === root.child('gym/adminPin').val()"
    }
   },
   "meta": {
    ".read": "auth != null",
    ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()"
   },
   "nextId": {
    ".read": "auth != null",
    ".write": "auth != null && newData.isNumber() && ((!data.exists() && newData.val() > 1000) || newData.val() === data.val() + 1)"
   },
   "mpin": {
    "$id": {
     ".read": false,
     ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val().matches(/^[0-9]{4}$/)) || root.child('gym/admins').child(auth.uid).exists())"
    }
   },
   "mdev": {
    "$id": {
     "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid && newData.child('pin').val() === root.child('gym/mpin').child($id).val()"
     }
    }
   },
   "members": {
    ".read": "auth != null",
    "$id": {
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || root.child('gym/mdev').child($id).child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() != null && $id === 'c' + root.child('gym/coaches').child(auth.uid).child('code').val() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))"
    }
   },
   "private": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    "$id": {
     ".read": "auth != null && (root.child('gym/mdev').child($id).child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() != null && $id === 'c' + root.child('gym/coaches').child(auth.uid).child('code').val() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || root.child('gym/mdev').child($id).child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() != null && $id === 'c' + root.child('gym/coaches').child(auth.uid).child('code').val() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))"
    }
   },
   "pays": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    "$pid": {
     ".write": "auth != null && (!data.exists() || root.child('gym/admins').child(auth.uid).exists())"
    }
   },
   "shots": {
    ".read": "auth != null",
    ".indexOn": [
     "at"
    ],
    "$sid": {
     ".write": "auth != null && ((!data.exists() && newData.child('mid').isString() && root.child('gym/mdev').child(newData.child('mid').val()).child(auth.uid).exists()) || (data.exists() && !newData.exists() && (root.child('gym/mdev').child(data.child('mid').val()).child(auth.uid).exists() || root.child('gym/admins').child(auth.uid).exists())))",
     ".validate": "newData.hasChildren(['mid','at','thumb']) && newData.child('thumb').isString() && newData.child('thumb').val().length < 80000"
    }
   },
   "shotimg": {
    ".read": "auth != null",
    "$sid": {
     ".write": "auth != null && ((!data.exists() && newData.child('mid').isString() && root.child('gym/mdev').child(newData.child('mid').val()).child(auth.uid).exists()) || (data.exists() && !newData.exists() && (root.child('gym/mdev').child(data.child('mid').val()).child(auth.uid).exists() || root.child('gym/admins').child(auth.uid).exists())))",
     ".validate": "newData.hasChildren(['mid','img']) && newData.child('img').isString() && newData.child('img').val().length < 300000"
    }
   },
   "likes": {
    ".read": "auth != null",
    "$sid": {
     "$uid": {
      ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.val() === true)"
     }
    }
   },
   "faces": {
    ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').isString() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
    "$id": {
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || root.child('gym/mdev').child($id).child(auth.uid).exists())",
     ".validate": "newData.isString() && newData.val().length < 80000"
    }
   },
   "outbox": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    ".indexOn": [
     "status"
    ],
    "$jid": {
     ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()"
    }
   },
   "sender": {
    ".read": "auth != null"
   },
   "coachcodes": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    "$code": {
     ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
     ".validate": "!newData.exists() || ($code.matches(/^[0-9]{6}$/) && newData.child('name').isString())"
    }
   },
   "coaches": {
    "$uid": {
     ".read": "auth != null && auth.uid === $uid",
     ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.child('code').isString() && root.child('gym/coachcodes').child(newData.child('code').val()).exists()))"
    }
   },
   "roster": {
    ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').isString() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
    "$id": {
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || root.child('gym/mdev').child($id).child(auth.uid).exists())",
     ".validate": "!newData.exists() || newData.child('name').isString()"
    }
   },
   "live": {
    ".read": "auth != null",
    "$id": {
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || root.child('gym/mdev').child($id).child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() != null && $id === 'c' + root.child('gym/coaches').child(auth.uid).child('code').val() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
     ".validate": "!newData.exists() || (newData.child('at').isNumber() && newData.child('nick').isString())"
    }
   },
   "backups": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()"
   },
   "staff": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    "$code": {
     ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()))",
     ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()"
    }
   },
   "hr": {
    "att": {
     ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
     "$code": {
      ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()))",
      "$date": {
       ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || ((root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()) && newData.exists() && (!data.exists() || !data.child('out').exists())))"
      }
     }
    },
    "leave": {
     ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
     "$code": {
      ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()))",
      "$id": {
       ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || ((root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()) && (!data.exists() || data.child('status').val() === 'pending') && (!newData.exists() || newData.child('status').val() === 'pending')))"
      }
     }
    },
    "fix": {
     ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
     "$code": {
      ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()))",
      "$id": {
       ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || ((root.child('gym/coaches').child(auth.uid).child('code').val() === $code && root.child('gym/coachcodes').child($code).exists()) && (!data.exists() || data.child('status').val() === 'pending') && (!newData.exists() || newData.child('status').val() === 'pending')))"
      }
     }
    }
   },
   "trials": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    "$id": {
     ".write": "auth != null && ((!data.exists() && newData.child('name').isString() && newData.child('phone').isString() && newData.child('status').val() === 'new') || root.child('gym/admins').child(auth.uid).exists())"
    }
   },
   "staffchat": {
    ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').exists() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
    "$id": {
     ".write": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || ((root.child('gym/coaches').child(auth.uid).child('code').exists() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))))",
     ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('at').isNumber() && newData.child('name').isString())"
    }
   },
   "staffnotice": {
    ".read": "auth != null && (root.child('gym/admins').child(auth.uid).exists() || (root.child('gym/coaches').child(auth.uid).child('code').exists() && root.child('gym/coachcodes').child(root.child('gym/coaches').child(auth.uid).child('code').val()).exists()))",
    "$id": {
     ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
     ".validate": "!newData.exists() || (newData.child('title').isString() && newData.child('at').isNumber())"
    }
   },
   "memos": {
    ".read": "auth != null && root.child('gym/admins').child(auth.uid).exists()",
    ".write": "auth != null && root.child('gym/admins').child(auth.uid).exists()"
   }
  }
 }
}