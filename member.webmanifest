{
  "id": "nnn-member-world",
  "name": "NNN WORLD · 탕정 엔엔엔복싱",
  "short_name": "NNN WORLD",
  "description": "탕정 엔엔엔복싱 회원 앱 NNN WORLD · 출석 · 등록 현황 · 체육관 월드",
  "lang": "ko",
  "start_url": "member.html?src=home",
  "scope": "./member",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDEEF0",
  "theme_color": "#2F2F2F",
  "icons": [
    {
      "src": "member-icons/v2/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "member-icons/v2/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "member-icons/v2/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "member.html?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/gif",
            ".mp4",
            ".mov",
            ".gif"
          ]
        }
      ]
    }
  }
}